# ---- Server ----
NODE_ENV=development
PORT=4000
# Origin(s) allowed by CORS, comma separated. The Next.js app proxies /api so this mostly matters for direct calls.
FRONTEND_URL=http://localhost:3000
# Public base URL of the frontend (used in invitation messages)
APP_URL=http://localhost:3000

# ---- Database ----
# Replace with your own PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/usman_gym?schema=public

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_DAYS=7
COOKIE_SECURE=false

# ---- Billing ----
APP_TIMEZONE=Asia/Karachi
GYM_ID_PREFIX=UG
# FULL_MONTH: billing starts in the month of joining. NEXT_MONTH: billing starts the month after joining.
BILLING_LATE_JOIN_POLICY=FULL_MONTH
# A pending fee becomes OVERDUE this many days after the 1st of its billing month.
OVERDUE_GRACE_DAYS=10
ENABLE_BILLING_CRON=true

# ---- OTP delivery ----
# console = development only (prints OTPs to the server log, refused in production)
# smtp    = email via SMTP
# twilio  = SMS via Twilio
OTP_PROVIDER=console
# DEV ONLY: fixed code accepted instead of a random one (console provider only; server refuses it in production)
# OTP_DEV_CODE=123456
OTP_TTL_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Usman Gym <no-reply@example.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2
MAX_PROOF_UPLOAD_MB=5

# ---- Initial admin (used only by `npm run db:seed`) ----
ADMIN_FULL_NAME=Gym Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+920000000000
ADMIN_PASSWORD=change-me-to-a-strong-password
